{
  "name": "wvv-insta-posts",
  "version": "1.0.0",
  "description": "Generates Instagram-ready slides (Portrait 4:5 and Stories) from a volleyball match schedule – with captions and ZIP download.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximilianKleissl/wvv-insta-posts.git"
  },
  "homepage": "https://maximiliankleissl.github.io/wvv-insta-posts",
  "bugs": {
    "url": "https://github.com/MaximilianKleissl/wvv-insta-posts/issues"
  },
  "keywords": [
    "vue",
    "vite",
    "typescript",
    "tailwindcss",
    "volleyball",
    "instagram",
    "social-media",
    "generator"
  ],
  "author": "Maximilian Kleissl",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.8",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.445.0",
    "vue": "^3.4.0",
    "vue-router": "^4.4.0",
    "zod": "^3.23.0"
  }
}
